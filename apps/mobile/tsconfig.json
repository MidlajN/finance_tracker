{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "es2023",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "src", "env.d.ts", "nativewind-env.d.ts"]
}

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.financeplatform.notifications" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
       HeadlessJsTaskService holds a partial wake lock while the capture
       pipeline runs with the screen off.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <receiver
            android:name="com.financeplatform.notifications.FinanceNotificationActionReceiver"
            android:exported="false" />

        <service
            android:name="com.financeplatform.notifications.FinanceNotificationHeadlessTaskService"
            android:exported="false" />
        <service
            android:name="com.financeplatform.notifications.FinanceNotificationListenerService"
            android:exported="true"
            android:label="Finance Tracker Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" >
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
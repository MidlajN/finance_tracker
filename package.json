{
  "name": "@finance/platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @finance/web",
    "build": "npm run typecheck && npm run build --workspace @finance/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace @finance/web",
    "preview": "npm run preview --workspace @finance/web"
  },
  "devDependencies": {
    "supabase": "^2.108.0",
    "typescript": "~6.0.2"
  }
}
